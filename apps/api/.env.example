# MedVoice AI — Environment Configuration

APP_ENV=development
DATABASE_URL=sqlite:///./test.db
SECRET_KEY=your-secret-key-here
LOG_LEVEL=INFO

# Provider Selection: vertex_gemma | ollama
LLM_PROVIDER=vertex_gemma

# Model Configuration
VERTEX_GEMMA_MODEL=gemma-4-31b-it
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Google Cloud / Vertex AI Authentication (Server-Side Only)
# Option A: API Key
VERTEX_API_KEY=your_google_api_key_here

# Option B: Vertex AI Project / Location (ADC)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Ollama Configuration (Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
